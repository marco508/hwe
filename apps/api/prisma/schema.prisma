// HWE — Real estate platform
// Prisma schema. PostGIS-ready (lat/lng kept as Float, can be backed by a
// geography(Point) column via raw SQL when scale demands it).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TENANT
  ADMIN
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  LAND
  COMMERCIAL
  OTHER
}

enum EnergyClass {
  A
  B
  C
  D
  E
  F
  G
}

enum RentalKind {
  BARE         // Location nue
  FURNISHED    // Location meublée
  SEASONAL     // Location saisonnière / courte durée
  STUDENT      // Bail étudiant
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  RENTED
  SOLD
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?  @db.Text
  role      Role     @default(TENANT)
  /// E-mail vérifié (lien envoyé à l'inscription). Requis pour publier un
  /// bien, envoyer une demande et accéder à son bail/ses loyers : le
  /// rattachement locataire↔bail repose sur l'e-mail.
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties     Property[] @relation("OwnerProperties")
  inquiries      Inquiry[]  @relation("SenderInquiries")
  favorites      Favorite[]
  userDocuments  UserDocument[]
  paymentMethods OwnerPaymentMethod[] @relation("OwnerPaymentMethods")
  tickets        Ticket[]   @relation("TicketAuthor")

  // Messagerie
  ownerConversations Conversation[] @relation("OwnerConversations")
  otherConversations Conversation[] @relation("OtherConversations")
  sentMessages       Message[]

  @@index([role])
}

enum IdentityDocumentType {
  NATIONAL_ID       // Carte nationale d'identité
  PASSPORT          // Passeport
  DRIVERS_LICENSE   // Permis de conduire
  RESIDENCE_PERMIT  // Titre de séjour
  OTHER
}

model UserDocument {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  documentType IdentityDocumentType
  fileUrl      String               @db.Text
  fileSize     Int?
  mimeType     String?
  notes        String?              @db.Text
  verifiedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  listingType ListingType
  propertyType PropertyType
  status      PropertyStatus @default(PUBLISHED)

  price    Float
  currency String @default("EUR")

  surface   Float
  rooms     Int
  bedrooms  Int
  bathrooms Int
  floor     Int?
  yearBuilt Int?

  furnished   Boolean @default(false)
  hasParking  Boolean @default(false)
  hasBalcony  Boolean @default(false)
  hasGarden   Boolean @default(false)
  hasElevator Boolean @default(false)

  // ── Champs spécifiques VENTE ─────────────────────────────────────────
  /// Charges mensuelles de copropriété (vente d'appartement)
  coOwnershipFees Float?
  /// Taxe foncière annuelle (vente)
  propertyTax     Float?
  /// Classe énergétique (Diagnostic de Performance Énergétique)
  energyClass     EnergyClass?
  /// Frais de notaire estimés (pourcentage du prix de vente, ex: 7.5)
  notaryFeesRate  Float?
  /// Bien neuf ou en VEFA (Vente en l'État Futur d'Achèvement)
  isNew           Boolean @default(false)

  // ── Champs spécifiques LOCATION ──────────────────────────────────────
  /// Type de bail (nu / meublé / saisonnier / étudiant)
  rentalKind      RentalKind?
  /// Charges incluses dans le loyer ?
  chargesIncluded Boolean?
  /// Montant mensuel des charges (si non incluses)
  chargesAmount   Float?
  /// Dépôt de garantie demandé
  deposit         Float?
  /// Préavis en mois exigé par le bailleur
  noticeMonths    Int?
  /// Animaux acceptés ?
  petsAllowed     Boolean?

  // Localisation
  addressLine String
  city        String
  postalCode  String
  country     String  @default("FR")
  latitude    Float?
  longitude   Float?

  ownerId String
  owner   User   @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  media         PropertyMedia[]
  inquiries     Inquiry[]
  documents     PropertyDocument[]
  leases        LeaseContract[]
  favorites     Favorite[]
  pricingRates  PricingRate[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingType])
  @@index([propertyType])
  @@index([city])
  @@index([country])
  @@index([status])
  @@index([price])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String   @db.Text
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

/// Grille tarifaire définie par le propriétaire pour une annonce de location.
/// Une seule entrée par unité (DAYS / WEEKS / MONTHS / YEARS) est autorisée.
model PricingRate {
  id         String            @id @default(cuid())
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit       LeaseDurationUnit
  /// Montant pour 1 unité (ex : 45 pour 45 €/jour)
  amount     Float
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([propertyId, unit])
  @@index([propertyId])
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum LeaseDurationUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

model Inquiry {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User          @relation("SenderInquiries", fields: [senderId], references: [id], onDelete: Cascade)
  message      String        @db.Text
  contactEmail String
  contactPhone String?
  /// Date de début souhaitée par le locataire
  desiredStartDate DateTime?
  /// Valeur numérique de la durée souhaitée
  leaseDuration    Int?
  /// Unité de la durée souhaitée
  leaseDurationUnit LeaseDurationUnit?
  status       InquiryStatus @default(PENDING)
  resolvedAt   DateTime?
  cancelledAt  DateTime?
  // If accepted, the generated lease contract
  leaseId      String?       @unique
  lease        LeaseContract? @relation(fields: [leaseId], references: [id])
  // Conversation associée (créée automatiquement à l'envoi de la demande)
  conversation Conversation?
  createdAt    DateTime      @default(now())

  @@index([propertyId])
  @@index([senderId])
  @@index([status])
}

/// Conversation entre un propriétaire et un locataire/acheteur, attachée
/// à un bien et à la demande initiale. Une conversation par couple
/// (propriétaire, autre utilisateur, bien).
model Conversation {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  inquiryId   String?  @unique
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  /// Propriétaire du bien
  ownerId     String
  owner       User     @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)

  /// L'autre partie (acheteur ou locataire potentiel)
  otherUserId String
  otherUser   User     @relation("OtherConversations", fields: [otherUserId], references: [id], onDelete: Cascade)

  /// Timestamp du dernier message pour tri rapide
  lastMessageAt DateTime?

  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, otherUserId, propertyId])
  @@index([ownerId, lastMessageAt])
  @@index([otherUserId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  /// Marqué lu quand l'autre partie consulte la conversation
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

enum DocumentType {
  TITLE_DEED          // Acte de propriété
  PROPERTY_TAX        // Taxe foncière
  CO_OWNERSHIP_RULES  // Règlement de copropriété
  DIAGNOSTICS         // Dossier de diagnostics techniques (DDT)
  INSURANCE           // Assurance
  WORK_PERMIT         // Permis de construire / déclaration travaux
  ENERGY_AUDIT        // Audit énergétique
  OTHER
}

model PropertyDocument {
  id           String       @id @default(cuid())
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  documentType DocumentType
  fileUrl      String       @db.Text
  fileSize     Int?         // bytes
  mimeType     String?
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([propertyId])
}

enum LeaseStatus {
  DRAFT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

model LeaseContract {
  id           String      @id @default(cuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status       LeaseStatus @default(DRAFT)

  // Tenant info
  tenantFirstName  String
  tenantLastName   String
  tenantEmail      String
  tenantPhone      String?
  tenantAddress    String?

  // Contract details
  monthlyRent      Float
  charges          Float   @default(0)
  deposit          Float
  startDate        DateTime
  endDate          DateTime?
  noticePeriod     Int     @default(1) // months
  rentPaymentDay   Int     @default(1) // day of month
  furnished        Boolean @default(false)

  // Special clauses
  specialClauses   String? @db.Text

  // Generated PDF URL (optional)
  pdfUrl           String? @db.Text

  // Signatures (electronic — timestamped acceptance)
  ownerSignedAt    DateTime?
  tenantSignedAt   DateTime?

  // ── Caution (dépôt de garantie) — suivi du cycle complet ──────────────
  /// Versement de la caution confirmé par le propriétaire
  depositPaidAt     DateTime?
  /// Restitution (fin de bail) confirmée par le propriétaire
  depositReturnedAt DateTime?
  /// Montant retenu à la restitution (0 = tout rendu)
  depositRetained   Float?
  /// Motif de la retenue / note sur la caution
  depositNote       String? @db.Text

  // Back-relation: the inquiry that generated this lease
  inquiry          Inquiry?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rentPeriods RentPeriod[]
  inspections Inspection[]
  tickets     Ticket[]

  @@index([propertyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉTATS DES LIEUX — un à l'entrée, un à la sortie, signés par les deux parties.
// ─────────────────────────────────────────────────────────────────────────────

enum InspectionType {
  ENTRY // état des lieux d'entrée
  EXIT  // état des lieux de sortie
}

model Inspection {
  id      String         @id @default(cuid())
  leaseId String
  lease   LeaseContract  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type    InspectionType
  date    DateTime

  /// Relevé par pièce/élément : [{ label, condition, note }]
  items            Json?
  generalNote      String? @db.Text
  meterElectricity String?
  meterWater       String?
  meterGas         String?
  keysCount        Int?

  // Signatures électroniques horodatées (comme le bail)
  ownerSignedAt  DateTime?
  tenantSignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, type])
  @@index([leaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TICKETS — incidents signalés par le locataire (fuite, panne…), suivis par
// le propriétaire jusqu'à résolution.
// ─────────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ticket {
  id       String        @id @default(cuid())
  leaseId  String
  lease    LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title        String
  description  String  @db.Text
  photoDataUrl String? @db.Text

  status         TicketStatus @default(OPEN)
  resolutionNote String?      @db.Text
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// LOYERS — paiement direct au propriétaire, déclaré puis validé.
//
// Le locataire verse le loyer directement au propriétaire (mobile money,
// virement…), sur les coordonnées que celui-ci publie. Il déclare ensuite son
// versement (identifiant de transaction de l'opérateur — UNIQUE : une même
// preuve ne peut pas couvrir deux échéances) ; le propriétaire, seul à voir
// son compte, valide — ce qui émet la quittance. La plateforme ne détient
// jamais les fonds : elle trace qui a déclaré quoi, qui a validé, et quand.
// ─────────────────────────────────────────────────────────────────────────────

// Coordonnées de versement d'un propriétaire, montrées au locataire.
model OwnerPaymentMethod {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation("OwnerPaymentMethods", fields: [ownerId], references: [id], onDelete: Cascade)
  // Ce que voit le locataire : « MTN MoMo », « Virement UBA »…
  label        String
  // Numéro ou compte, format libre.
  value        String
  // Nom du titulaire : le locataire doit vérifier à qui il envoie.
  holder       String?
  instructions String?
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, active])
}

enum RentStatus {
  DUE       // échéance à payer
  DECLARED  // versement déclaré par le locataire, à vérifier
  PAID      // validé par le propriétaire — quittance émise
  LATE      // échue sans paiement (posée par le planificateur)
}

// Une échéance mensuelle d'un bail actif. Générée à l'activation du bail puis
// chaque mois par le planificateur ; le montant est figé à la génération pour
// que la quittance reste juste même si le bail est modifié ensuite.
model RentPeriod {
  id          String        @id @default(cuid())
  leaseId     String
  lease       LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodYear  Int
  periodMonth Int // 1..12
  dueDate     DateTime
  amount      Float
  status      RentStatus    @default(DUE)

  // Déclaration du locataire
  declaredAt     DateTime?
  declaredMethod String?
  // Identifiant de transaction de l'opérateur — unique : anti-réutilisation.
  declaredRef    String?   @unique
  proofDataUrl   String?   @db.Text
  tenantNote     String?

  // Validation du propriétaire
  paidAt       DateTime?
  receiptNo    String?   @unique
  rejectReason String?
  // Dernier rappel envoyé (anti-spam : un seul par échéance et par retard)
  remindedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, periodYear, periodMonth])
  @@index([status, dueDate])
}
