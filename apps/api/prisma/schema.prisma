// HWE — Real estate platform
// Prisma schema. PostGIS-ready (lat/lng kept as Float, can be backed by a
// geography(Point) column via raw SQL when scale demands it).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TENANT
  ADMIN
  /// Professionnel (agence, démarcheur, commercial) : responsable ou agent.
  AGENT
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  LAND
  COMMERCIAL
  OTHER
}

enum EnergyClass {
  A
  B
  C
  D
  E
  F
  G
}

enum RentalKind {
  BARE         // Location nue
  FURNISHED    // Location meublée
  SEASONAL     // Location saisonnière / courte durée
  STUDENT      // Bail étudiant
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  RENTED
  SOLD
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?  @db.Text
  role      Role     @default(TENANT)
  /// E-mail vérifié (lien envoyé à l'inscription). Requis pour publier un
  /// bien, envoyer une demande et accéder à son bail/ses loyers : le
  /// rattachement locataire↔bail repose sur l'e-mail.
  emailVerifiedAt DateTime?
  /// Version des jetons : incrémentée à chaque réinitialisation de mot de
  /// passe → les JWT émis avant deviennent invalides (401).
  tokenVersion Int @default(0)
  /// Clé publique (non devinable) de l'avatar, servi par GET /api/media/avatar/<clé>.
  /// Change à chaque nouvel avatar (cache HTTP immuable), null sans avatar.
  avatarKey String? @unique
  /// Compte activé (mot de passe choisi par son titulaire). Null pour un
  /// propriétaire créé par un professionnel tant qu'il n'a pas utilisé son
  /// lien d'invitation (ou « mot de passe oublié ») : connexion refusée.
  activatedAt       DateTime?
  /// Agence qui a créé ce compte invité (propriétaire sans compte).
  invitedByAgencyId String?
  invitedByAgency   Agency?  @relation("AgencyInvitedOwners", fields: [invitedByAgencyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencyMember   AgencyMember?
  properties     Property[] @relation("OwnerProperties")
  inquiries      Inquiry[]  @relation("SenderInquiries")
  favorites      Favorite[]
  userDocuments  UserDocument[]
  paymentMethods OwnerPaymentMethod[] @relation("OwnerPaymentMethods")
  tickets        Ticket[]   @relation("TicketAuthor")
  visits         Visit[]    @relation("VisitRequester")

  // Messagerie
  ownerConversations Conversation[] @relation("OwnerConversations")
  otherConversations Conversation[] @relation("OtherConversations")
  sentMessages       Message[]

  @@index([role])
}

enum IdentityDocumentType {
  NATIONAL_ID       // Carte nationale d'identité
  PASSPORT          // Passeport
  DRIVERS_LICENSE   // Permis de conduire
  RESIDENCE_PERMIT  // Titre de séjour
  // ── Dossier de candidature ──
  INCOME_PROOF      // Justificatif de revenus (bulletins de salaire…)
  EMPLOYMENT_CONTRACT // Contrat de travail / attestation employeur
  TAX_NOTICE        // Avis d'imposition
  GUARANTOR_ID      // Pièce d'identité du garant
  GUARANTOR_INCOME  // Justificatif de revenus du garant
  OTHER
}

model UserDocument {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  documentType IdentityDocumentType
  fileUrl      String               @db.Text
  fileSize     Int?
  mimeType     String?
  notes        String?              @db.Text
  verifiedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  listingType ListingType
  propertyType PropertyType
  status      PropertyStatus @default(PUBLISHED)

  price    Float
  currency String @default("EUR")

  surface   Float
  rooms     Int
  bedrooms  Int
  bathrooms Int
  floor     Int?
  yearBuilt Int?

  furnished   Boolean @default(false)
  hasParking  Boolean @default(false)
  hasBalcony  Boolean @default(false)
  hasGarden   Boolean @default(false)
  hasElevator Boolean @default(false)

  // ── Champs spécifiques VENTE ─────────────────────────────────────────
  /// Charges mensuelles de copropriété (vente d'appartement)
  coOwnershipFees Float?
  /// Taxe foncière annuelle (vente)
  propertyTax     Float?
  /// Classe énergétique (Diagnostic de Performance Énergétique)
  energyClass     EnergyClass?
  /// Frais de notaire estimés (pourcentage du prix de vente, ex: 7.5)
  notaryFeesRate  Float?
  /// Bien neuf ou en VEFA (Vente en l'État Futur d'Achèvement)
  isNew           Boolean @default(false)

  // ── Champs spécifiques LOCATION ──────────────────────────────────────
  /// Type de bail (nu / meublé / saisonnier / étudiant)
  rentalKind      RentalKind?
  /// Charges incluses dans le loyer ?
  chargesIncluded Boolean?
  /// Montant mensuel des charges (si non incluses)
  chargesAmount   Float?
  /// Dépôt de garantie demandé
  deposit         Float?
  /// Préavis en mois exigé par le bailleur
  noticeMonths    Int?
  /// Animaux acceptés ?
  petsAllowed     Boolean?

  // Localisation
  addressLine String
  city        String
  postalCode  String
  country     String  @default("FR")
  latitude    Float?
  longitude   Float?

  ownerId String
  owner   User   @relation("OwnerProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Vente conclue : prix final et date (PATCH status SOLD + salePrice).
  soldPrice Float?
  soldAt    DateTime?

  media         PropertyMedia[]
  mandates      Mandate[]
  inquiries     Inquiry[]
  documents     PropertyDocument[]
  leases        LeaseContract[]
  favorites     Favorite[]
  pricingRates  PricingRate[]
  conversations Conversation[]
  visits        Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingType])
  @@index([propertyType])
  @@index([city])
  @@index([country])
  @@index([status])
  @@index([price])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String   @db.Text
  alt        String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

/// Grille tarifaire définie par le propriétaire pour une annonce de location.
/// Une seule entrée par unité (DAYS / WEEKS / MONTHS / YEARS) est autorisée.
model PricingRate {
  id         String            @id @default(cuid())
  propertyId String
  property   Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit       LeaseDurationUnit
  /// Montant pour 1 unité (ex : 45 pour 45 €/jour)
  amount     Float
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([propertyId, unit])
  @@index([propertyId])
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum LeaseDurationUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

model Inquiry {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User          @relation("SenderInquiries", fields: [senderId], references: [id], onDelete: Cascade)
  message      String        @db.Text
  contactEmail String
  contactPhone String?
  /// Date de début souhaitée par le locataire
  desiredStartDate DateTime?
  /// Valeur numérique de la durée souhaitée
  leaseDuration    Int?
  /// Unité de la durée souhaitée
  leaseDurationUnit LeaseDurationUnit?
  /// Le candidat partage son dossier (documents du profil) avec le propriétaire
  shareDossier Boolean       @default(false)
  status       InquiryStatus @default(PENDING)
  resolvedAt   DateTime?
  cancelledAt  DateTime?
  // If accepted, the generated lease contract
  leaseId      String?       @unique
  lease        LeaseContract? @relation(fields: [leaseId], references: [id])
  // Conversation associée (créée automatiquement à l'envoi de la demande)
  conversation Conversation?

  // ── Proposition au propriétaire par un professionnel sous mandat ──
  proposedAt        DateTime?
  proposedById      String?
  proposalNote      String?        @db.Text
  ownerDecision     OwnerDecision?
  ownerDecisionAt   DateTime?
  ownerDecisionNote String?        @db.Text

  createdAt    DateTime      @default(now())

  @@index([propertyId])
  @@index([senderId])
  @@index([status])
}

/// Conversation entre un propriétaire et un locataire/acheteur, attachée
/// à un bien et à la demande initiale. Une conversation par couple
/// (propriétaire, autre utilisateur, bien).
model Conversation {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  inquiryId   String?  @unique
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  /// Propriétaire du bien
  ownerId     String
  owner       User     @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)

  /// L'autre partie (acheteur ou locataire potentiel)
  otherUserId String
  otherUser   User     @relation("OtherConversations", fields: [otherUserId], references: [id], onDelete: Cascade)

  /// Timestamp du dernier message pour tri rapide
  lastMessageAt DateTime?

  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, otherUserId, propertyId])
  @@index([ownerId, lastMessageAt])
  @@index([otherUserId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  /// Marqué lu quand l'autre partie consulte la conversation
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

enum DocumentType {
  TITLE_DEED          // Acte de propriété
  PROPERTY_TAX        // Taxe foncière
  CO_OWNERSHIP_RULES  // Règlement de copropriété
  DIAGNOSTICS         // Dossier de diagnostics techniques (DDT)
  INSURANCE           // Assurance
  WORK_PERMIT         // Permis de construire / déclaration travaux
  ENERGY_AUDIT        // Audit énergétique
  OTHER
}

model PropertyDocument {
  id           String       @id @default(cuid())
  propertyId   String
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  documentType DocumentType
  fileUrl      String       @db.Text
  fileSize     Int?         // bytes
  mimeType     String?
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([propertyId])
}

enum LeaseStatus {
  DRAFT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

model LeaseContract {
  id           String      @id @default(cuid())
  propertyId   String
  // Restrict : supprimer un bien ne doit jamais détruire l'historique des
  // baux et quittances (le bien s'archive).
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  status       LeaseStatus @default(DRAFT)
  /// Devise du bail (copiée du bien à la création) : loyers et quittances.
  currency     String      @default("EUR")
  /// Location courte durée (jours/semaines) : une seule échéance du total.
  shortStay    Boolean     @default(false)
  stayTotal    Float?

  // Tenant info
  tenantFirstName  String
  tenantLastName   String
  tenantEmail      String
  tenantPhone      String?
  tenantAddress    String?

  // Contract details
  monthlyRent      Float
  charges          Float   @default(0)
  deposit          Float
  startDate        DateTime
  endDate          DateTime?
  noticePeriod     Int     @default(1) // months
  rentPaymentDay   Int     @default(1) // day of month
  furnished        Boolean @default(false)

  // Special clauses
  specialClauses   String? @db.Text

  // Generated PDF URL (optional)
  pdfUrl           String? @db.Text

  // Signatures (electronic — timestamped acceptance)
  ownerSignedAt    DateTime?
  tenantSignedAt   DateTime?
  /// Auteur de la signature côté bailleur (propriétaire, ou professionnel
  /// mandataire quand le propriétaire n'a pas activé son compte).
  ownerSignedById  String?
  /// Mention « Signé par X (Agence), mandataire, pour le compte de Y — mandat MAN-… ».
  ownerSignatureMention String? @db.Text
  /// Professionnel qui a préparé / modifié le brouillon (null : le propriétaire).
  preparedById     String?
  /// Empreinte SHA-256 du contenu au moment de la double signature.
  contentHash      String?

  /// Marqueurs d'envoi des alertes de fin de bail (une seule fois chacune).
  expiryReminder7At DateTime?
  expiryReminder1At DateTime?

  // ── Caution (dépôt de garantie) — suivi du cycle complet ──────────────
  /// Versement de la caution confirmé par le propriétaire
  depositPaidAt     DateTime?
  /// Restitution (fin de bail) confirmée par le propriétaire
  depositReturnedAt DateTime?
  /// Montant retenu à la restitution (0 = tout rendu)
  depositRetained   Float?
  /// Motif de la retenue / note sur la caution
  depositNote       String? @db.Text

  // ── Congé donné par le propriétaire (vente, reprise, motif légitime) ──
  ownerNoticeGivenAt       DateTime?
  ownerNoticeEffectiveDate DateTime?
  /// SALE (vente), REPOSSESSION (reprise pour habiter), OTHER (motif légitime)
  ownerNoticeReason        String?
  ownerNoticeNote          String? @db.Text

  // ── Préavis (congé donné par le locataire) ──
  /// Date à laquelle le locataire a notifié son départ
  noticeGivenAt       DateTime?
  /// Date effective de fin calculée (≥ préavis contractuel)
  noticeEffectiveDate DateTime?
  noticeNote          String? @db.Text

  // Back-relation: the inquiry that generated this lease
  inquiry          Inquiry?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rentPeriods RentPeriod[]
  inspections Inspection[]
  tickets     Ticket[]
  amendments  LeaseAmendment[]
  coTenants   LeaseCoTenant[]
  insurances  InsuranceCertificate[]
  chargeRegularizations ChargeRegularization[]

  @@index([propertyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉTATS DES LIEUX — un à l'entrée, un à la sortie, signés par les deux parties.
// ─────────────────────────────────────────────────────────────────────────────

enum InspectionType {
  ENTRY // état des lieux d'entrée
  EXIT  // état des lieux de sortie
}

model Inspection {
  id      String         @id @default(cuid())
  leaseId String
  lease   LeaseContract  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type    InspectionType
  date    DateTime

  /// Relevé par pièce/élément : [{ label, condition, note }]
  items            Json?
  generalNote      String? @db.Text
  meterElectricity String?
  meterWater       String?
  meterGas         String?
  keysCount        Int?

  // Signatures électroniques horodatées (comme le bail)
  ownerSignedAt  DateTime?
  tenantSignedAt DateTime?
  /// Signataire côté bailleur et mention « par X, mandataire de Y » si pro.
  ownerSignedById       String?
  ownerSignatureMention String? @db.Text
  /// Dernier rédacteur (propriétaire ou professionnel).
  updatedById           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, type])
  @@index([leaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TICKETS — incidents signalés par le locataire (fuite, panne…), suivis par
// le propriétaire jusqu'à résolution.
// ─────────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ticket {
  id       String        @id @default(cuid())
  leaseId  String
  lease    LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title        String
  description  String  @db.Text
  photoDataUrl String? @db.Text

  status         TicketStatus @default(OPEN)
  resolutionNote String?      @db.Text
  resolvedAt     DateTime?
  /// Dernière personne côté bailleur qui a fait avancer l'incident.
  handledById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// LOYERS — paiement direct au propriétaire, déclaré puis validé.
//
// Le locataire verse le loyer directement au propriétaire (mobile money,
// virement…), sur les coordonnées que celui-ci publie. Il déclare ensuite son
// versement (identifiant de transaction de l'opérateur — UNIQUE : une même
// preuve ne peut pas couvrir deux échéances) ; le propriétaire, seul à voir
// son compte, valide — ce qui émet la quittance. La plateforme ne détient
// jamais les fonds : elle trace qui a déclaré quoi, qui a validé, et quand.
// ─────────────────────────────────────────────────────────────────────────────

// Coordonnées de versement d'un propriétaire, montrées au locataire.
model OwnerPaymentMethod {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation("OwnerPaymentMethods", fields: [ownerId], references: [id], onDelete: Cascade)
  // Ce que voit le locataire : « MTN MoMo », « Virement UBA »…
  label        String
  // Numéro ou compte, format libre.
  value        String
  // Nom du titulaire : le locataire doit vérifier à qui il envoie.
  holder       String?
  instructions String?
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, active])
}

enum RentStatus {
  DUE       // échéance à payer
  DECLARED  // versement déclaré par le locataire, à vérifier
  PAID      // validé par le propriétaire — quittance émise
  LATE      // échue sans paiement (posée par le planificateur)
}

// Une échéance mensuelle d'un bail actif. Générée à l'activation du bail puis
// chaque mois par le planificateur ; le montant est figé à la génération pour
// que la quittance reste juste même si le bail est modifié ensuite.
model RentPeriod {
  id          String        @id @default(cuid())
  leaseId     String
  lease       LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  periodYear  Int
  periodMonth Int // 1..12
  dueDate     DateTime
  /// Total dû (= rentAmount + chargesAmount), figé à la génération.
  amount      Float
  /// Loyer et charges figés de la période (quittance juste après avenant).
  rentAmount    Float
  chargesAmount Float
  status      RentStatus    @default(DUE)

  // Déclaration du locataire
  declaredAt     DateTime?
  declaredMethod String?
  // Identifiant de transaction de l'opérateur — unique : anti-réutilisation.
  declaredRef    String?   @unique
  proofDataUrl   String?   @db.Text
  tenantNote     String?

  // Validation du propriétaire
  paidAt       DateTime?
  /// Auteur de la validation / du refus (propriétaire ou professionnel).
  reviewedById String?
  receiptNo    String?   @unique
  rejectReason String?
  // Dernier rappel envoyé (anti-spam : un seul par échéance et par retard)
  remindedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leaseId, periodYear, periodMonth])
  @@index([status, dueDate])
}

// ─────────────────────────────────────────────
// AVENANTS — modification du bail (loyer, charges, fin) re-signée par le
// locataire ; appliquée au bail au moment de sa signature.
// ─────────────────────────────────────────────

model LeaseAmendment {
  id      String        @id @default(cuid())
  leaseId String
  lease   LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  effectiveDate  DateTime
  newMonthlyRent Float?
  newCharges     Float?
  newEndDate     DateTime?
  note           String?  @db.Text

  /// Le propriétaire signe en créant l'avenant ; un avenant préparé par un
  /// professionnel attend la signature du propriétaire (null).
  ownerSignedAt  DateTime? @default(now())
  tenantSignedAt DateTime?
  /// Auteur de l'avenant et signataire côté bailleur.
  createdById    String?
  ownerSignedById String?
  ownerSignatureMention String? @db.Text
  /// Date d'application effective au bail (à effectiveDate, une fois signé)
  appliedAt      DateTime?
  /// Valeurs du bail avant application (calcul des échéances passées)
  prevMonthlyRent Float?
  prevCharges     Float?
  prevEndDate     DateTime?

  createdAt DateTime @default(now())

  @@index([leaseId])
}

// ─────────────────────────────────────────────
// COLOCATION — locataires supplémentaires sur un bail, chacun signe sa ligne.
// ─────────────────────────────────────────────

model LeaseCoTenant {
  id      String        @id @default(cuid())
  leaseId String
  lease   LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?
  signedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([leaseId, email])
  @@index([email])
}

// ─────────────────────────────────────────────
// ASSURANCE HABITATION — attestations déposées par le locataire.
// ─────────────────────────────────────────────

model InsuranceCertificate {
  id      String        @id @default(cuid())
  leaseId String
  lease   LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  fileUrl    String   @db.Text
  validUntil DateTime
  uploadedAt DateTime @default(now())

  @@index([leaseId, validUntil])
}

// ─────────────────────────────────────────────
// VISITES — demande de créneau par le candidat, confirmée par le propriétaire.
// ─────────────────────────────────────────────

enum VisitStatus {
  REQUESTED // demandée par le candidat
  CONFIRMED // confirmée par le propriétaire
  DECLINED  // refusée (voir ownerNote)
  CANCELLED // annulée par le candidat
}

model Visit {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User     @relation("VisitRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  proposedAt DateTime
  status     VisitStatus @default(REQUESTED)
  note       String?     @db.Text
  ownerNote  String?     @db.Text
  /// Personne côté bailleur qui a confirmé / refusé.
  answeredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, status])
  @@index([requesterId])
}

// ─────────────────────────────────────────────
// RÉGULARISATION DES CHARGES — comparaison annuelle provisions vs réel.
// Le solde est purement informatif : le règlement se fait hors plateforme.
// ─────────────────────────────────────────────

model ChargeRegularization {
  id      String        @id @default(cuid())
  leaseId String
  lease   LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  /// Période couverte, ex. « 2026 » ou « sept. 2025 – août 2026 »
  periodLabel         String
  /// Provisions encaissées sur la période
  provisionsCollected Float
  /// Charges réelles justifiées
  actualCharges       Float
  /// actualCharges - provisionsCollected : positif = complément dû par le
  /// locataire, négatif = trop-perçu à lui rembourser
  balance             Float
  note                String? @db.Text

  createdAt DateTime @default(now())

  @@index([leaseId])
}

// ─────────────────────────────────────────────
// NUMÉROTATION DES QUITTANCES — un compteur par année d'émission, incrémenté
// atomiquement (INSERT … ON CONFLICT … RETURNING) : pas de doublon ni de trou
// en cas de validations simultanées.
// ─────────────────────────────────────────────

model ReceiptCounter {
  year Int @id
  last Int @default(0)
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFESSIONNELS — agences, équipes, mandats, honoraires.
// ─────────────────────────────────────────────────────────────────────────────

enum AgencyRole {
  MANAGER
  AGENT
}

/// Agence (ou démarcheur indépendant = agence d'une personne).
model Agency {
  id                 String   @id @default(cuid())
  name               String   @db.VarChar(120)
  slug               String   @unique
  /// Code court communiqué aux propriétaires (« Confier un bien »).
  code               String   @unique
  /// Logo en data-URL (jamais renvoyé) et clé publique /api/media/agency/<clé>.
  logoDataUrl        String?  @db.Text
  logoKey            String?  @unique
  email              String?
  phone              String?
  address            String?
  city               String?
  country            String   @default("FR")
  registrationNumber String?
  description        String?  @db.VarChar(2000)
  /// Encaissement des loyers par l'agence (mandat rentPayee = AGENCY).
  paymentIban        String?
  paymentHolder      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members        AgencyMember[]
  invites        AgencyInvite[]
  mandates       Mandate[]
  mandateRequests MandateRequest[]
  invitedOwners  User[] @relation("AgencyInvitedOwners")
}

model AgencyMember {
  id        String     @id @default(cuid())
  agencyId  String
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  /// Un utilisateur appartient à une seule agence.
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AgencyRole @default(AGENT)
  createdAt DateTime   @default(now())

  @@index([agencyId])
}

model AgencyInvite {
  id          String     @id @default(cuid())
  agencyId    String
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email       String
  role        AgencyRole @default(AGENT)
  /// SHA-256 du jeton (le jeton en clair n'est jamais stocké).
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime   @default(now())

  @@index([agencyId])
}

enum MandateType {
  LETTING    // mise en location seule
  MANAGEMENT // gestion locative complète
  SALE       // vente
}

enum MandateStatus {
  PENDING_OWNER
  ACTIVE
  REJECTED
  ENDED
}

enum MandateOrigin {
  AGENCY // proposé par l'agence (invitation, ou bien créé pour un propriétaire invité)
  OWNER  // confié par le propriétaire lui-même
}

enum RentPayee {
  OWNER
  AGENCY
}

/// Mandat d'une agence sur UN bien. Un seul mandat ACTIVE ou PENDING_OWNER
/// par bien (verrou consultatif + index unique partiel).
model Mandate {
  id                String        @id @default(cuid())
  reference         String        @unique
  propertyId        String
  // Restrict : l'historique des mandats et honoraires survit (le bien s'archive).
  property          Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agencyId          String
  agency            Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedAgentId   String?
  ownerId           String
  type              MandateType
  status            MandateStatus @default(PENDING_OWNER)
  startDate         DateTime
  endDate           DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  endedAt           DateTime?
  endReason         String?       @db.Text
  endedById         String?
  createdBy         MandateOrigin @default(AGENCY)
  createdById       String
  message           String?       @db.Text
  managementFeeRate Float?
  lettingFeeAmount  Float?
  lettingFeeMonths  Float?
  saleFeeRate       Float?
  currency          String        @default("EUR")
  rentPayee         RentPayee     @default(OWNER)
  requestId         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events MandateEvent[]
  fees   FeeEntry[]

  @@index([propertyId, status])
  @@index([agencyId, status])
  @@index([ownerId])
  @@index([assignedAgentId])
}

enum MandateRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Demande de mandat sans bien désigné : le propriétaire choisit lui-même
/// les biens à confier en l'acceptant.
model MandateRequest {
  id                String               @id @default(cuid())
  agencyId          String
  agency            Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  ownerId           String
  createdById       String
  type              MandateType
  status            MandateRequestStatus @default(PENDING)
  startDate         DateTime
  endDate           DateTime?
  message           String?              @db.Text
  managementFeeRate Float?
  lettingFeeAmount  Float?
  lettingFeeMonths  Float?
  saleFeeRate       Float?
  rentPayee         RentPayee            @default(OWNER)
  resolvedAt        DateTime?
  createdAt         DateTime             @default(now())

  @@index([ownerId, status])
  @@index([agencyId, status])
}

/// Historique horodaté d'un mandat, visible par les deux parties.
model MandateEvent {
  id        String   @id @default(cuid())
  mandateId String
  mandate   Mandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  actorId   String?
  /// CREATED, ACCEPTED, REJECTED, ENDED, AGENT_ASSIGNED, TENANT_PROPOSED,
  /// TENANT_APPROVED, TENANT_DECLINED, LEASE_PREPARED, ACTED_ON_BEHALF…
  kind      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([mandateId, createdAt])
}

enum FeeKind {
  MANAGEMENT
  LETTING
  SALE
}

enum FeeStatus {
  DUE
  SETTLED
  CANCELLED
}

/// Honoraire dû à l'agence (suivi seulement : aucun encaissement en ligne).
model FeeEntry {
  id          String    @id @default(cuid())
  mandateId   String
  mandate     Mandate   @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind        FeeKind
  amount      Float
  currency    String
  /// Honoraire de gestion : une entrée par échéance (idempotence).
  rentPeriodId String?  @unique
  leaseId     String?
  label       String
  dueDate     DateTime
  status      FeeStatus @default(DUE)
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([mandateId, dueDate])
  @@index([status])
}

/// Numérotation des mandats (MAN-<année>-<n>), même principe que les quittances.
model MandateCounter {
  year Int @id
  last Int @default(0)
}

enum OwnerDecision {
  APPROVED
  DECLINED
}
