# Postgres
DATABASE_URL="postgresql://hwe:hwe@localhost:5435/hwe?schema=public"

# API
API_PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3006,http://localhost:3005,http://localhost:3004"

# Frontends (ports exposes par docker-compose)
NEXT_PUBLIC_API_URL="http://localhost:4005"

# Landing -> liens vers les deux espaces
NEXT_PUBLIC_TENANT_URL="http://localhost:3004"
NEXT_PUBLIC_OWNER_URL="http://localhost:3005"

# E-mails (facultatif) : SMTP propre à hwe. Sans SMTP_HOST, les e-mails partent
# par le hub DKP s'il est configuré (ci-dessous), sinon ils sont journalisés.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Écosystème DKP Solution (facultatif, docs/ECOSYSTEME-DKP.md). Sans ces
# variables, hwe se comporte comme avant : boutons et liens masqués.
# Hub : Compte DKP (connexion), e-mails, paiement en ligne de l'abonnement pro.
DKP_HUB_URL=
DKP_PUBLIC_URL=
DKP_CLIENT_ID=
DKP_CLIENT_SECRET=
# « 0 » pour couper une fonction tout en gardant le hub (défaut : active).
DKP_LOGIN=
DKP_PAYMENTS=
# Adresse de retour OAuth (défaut : PUBLIC_API_URL + /auth/dkp/callback).
DKP_REDIRECT_URI=
# API partenaire exposée par hwe (partage du loyer) : familyfe:<clé>
DKP_PARTNER_KEYS=
# Liens vers les autres services (boutons contextuels, « Services DKP »).
ZEMI_PUBLIC_URL=
AFROCHINA_PUBLIC_URL=
AFROCHINA_REQUEST_PATH=
GESTIPRO_PUBLIC_URL=
FAMILYFE_PUBLIC_URL=
# API GestiPro (factures des honoraires des agences).
GESTIPRO_PARTNER_URL=
